# Gautam Buddha University (GBU) Stores & Purchase Department
# Backend Environment Variables Template

# Environment: "development" | "production"
ENV=development

# Database URL:
# Local SQLite development (default):
DATABASE_URL=sqlite:///./inv.db

# Production (TiDB Cloud Serverless or Aiven MySQL):
# DATABASE_URL=mysql+pymysql://<username>:<password>@<host>:4000/<database>?charset=utf8mb4
# Enable SSL for cloud MySQL (required by TiDB Cloud / Aiven):
# DB_SSL=1
# Optional custom CA bundle path (falls back to certifi / system CA if omitted):
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# JWT Secret Key:
# Required in production. Generate a secure 32-byte hex token with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Allowed CORS origins (comma-separated, no trailing slashes):
ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-gbu-frontend.vercel.app

# Demo accounts display toggle on login screen ("true" | "false"):
SHOW_DEMO_ACCOUNTS=true
