# Gautam Buddha University (GBU) Stores & Purchase Department
# Backend Environment Variables

# Database URL:
# Local development (default):
DATABASE_URL=sqlite:///./inv.db

# Production (TiDB Cloud or Aiven MySQL):
# DATABASE_URL=mysql+pymysql://<username>:<password>@<host>:4000/<database>?charset=utf8mb4
# Enable SSL for cloud MySQL:
# DB_SSL=1
# Optional custom CA bundle path (falls back to certifi / system CA if omitted):
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# JWT Secret Key (Generate via: python3 -c "import secrets; print(secrets.token_hex(32))"):
SECRET_KEY=generate_your_own_secure_random_key_here

# Allowed CORS origins (comma-separated, set your actual Vercel domain):
ORIGINS=http://localhost:5173,http://localhost:3000,https://gbu-inventory-portal.vercel.app
